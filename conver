# Lambda auto-creates its log group on first invocation, so the groups already
# exist for the current environments. These imports let Terraform adopt the
# existing group instead of failing with ResourceAlreadyExistsException.
# Harmless once imported, and a no-op for environments where Terraform creates
# the group itself.
import {
  to = module.policy_graph_ingest_lambda.aws_cloudwatch_log_group.this[0]
  id = "/aws/lambda/${var.application_name}-${var.env_tier}-policy-graph-ingest-lambda"
}

import {
  to = module.soap_verification_lambda.aws_cloudwatch_log_group.this[0]
  id = "/aws/lambda/${var.application_name}-${var.env_tier}-soap-verification-lambda"
}

tofu fmt imports.tf lambda.tf
git add imports.tf lambda.tf
git commit -m "Manage Lambda log groups in Terraform"
git push
