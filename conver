# ---------------------------
# CloudWatch Logs
#
# Defaults to false so existing callers are unaffected. Log groups are
# otherwise auto-created by AWS on first invocation with no retention set,
# which leaves them unmanaged and never-expiring. Enabling this brings the
# group under Terraform with an explicit retention period.
#
# NOTE: if the function has already run, its log group exists and must be
# imported before enabling this, or the apply fails with
# ResourceAlreadyExistsException.
# ---------------------------
variable "create_log_group" {
  description = "Whether the module manages the function's CloudWatch log group."
  type        = bool
  default     = false
}

variable "log_retention_days" {
  description = "Retention in days for the function's log group. Only used when create_log_group = true."
  type        = number
  default     = 30

  validation {
    condition     = var.log_retention_days > 0
    error_message = "log_retention_days must be a positive number."
  }
}
