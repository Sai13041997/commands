$env:AWS_PROFILE = "L2-Pre-Prod"
aws logs tail /aws/apigateway/realtimeinsurance-perf-api-gateway/default --follow --region us-east-1


  # Accept both the v2 audience format (api://<guid>) and the v1 bare GUID.
  # Entra v1 tokens carry aud as the bare app ID; v2 tokens use the api:// URI.
  # Both are accepted until clients migrate to v2 tokens.
  jwt_audience = [
    var.entra_audience,
    replace(var.entra_audience, "api://", ""),
  ]
