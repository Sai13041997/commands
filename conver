# The Aurora cluster, subnet group and its security group are now managed in
# tf-aws-aurorapostgres-infra (apps/realtimeinsurance). This repo reads their
# outputs via remote state instead of owning the resources directly.
data "terraform_remote_state" "aurora" {
  backend = "s3"

  config = {
    bucket = "kfb-github-terraform-state"
    key    = "env:/${var.env_tier}/tf-aws-aurorapostgres-infra/apps/realtimeinsurance/terraform.tfstate"
    region = "us-east-1"
  }
}
